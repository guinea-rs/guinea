---
import { asset } from '../utils/asset';

const repo = 'https://github.com/guinea-rs/guinea';

const links: [string, string][] = [
  ['Examples', `${repo}/tree/master/examples`],
  ['Plugins', 'https://github.com/guinea-rs/guinea-plugins'],
  ['crates.io', 'https://crates.io/crates/guinea'],
  ['GitHub', repo],
];

const backends = ['WinUI', 'Slint', 'egui', 'iced', 'ratatui'];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" href={asset('/favicon.ico')} sizes="any" />
  <link rel="icon" type="image/svg+xml" href={asset('/guinea.svg')} />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="The application layer for Rust GUI: reducers, actors and features, nested routes, and five backends behind one domain." />
  <title>guinea — the application layer for Rust GUI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;700&family=Share+Tech+Mono&display=swap" />
</head>
<body>

<div id="page">
  <canvas id="meadow" aria-hidden="true"></canvas>

  <header class="bar">
    <a class="brand" href={asset('/')}>
      <img src={asset('/guinea.svg')} alt="" width="32" height="32" />
      guinea
    </a>
    <nav class="links">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </header>

  <main class="hero">
    <div class="backends">{backends.join(' · ')}</div>
    <h1>The application layer for Rust GUI.</h1>
    <p class="lede">
      State is a reducer, the domain is actors, and a feature owns both.
      Pages are written the way their toolkit works; routes, lifetimes,
      tracing and tests come with the architecture.
    </p>
    <div class="actions">
      <div class="install">
        <span class="prompt">$</span>
        <span>cargo add guinea</span>
        <button id="copy" type="button">copy</button>
      </div>
      <a class="start" href={`${repo}#readme`}>Get started</a>
    </div>
  </main>

  <footer class="foot">guinea · MIT OR Apache-2.0</footer>
</div>

<script>
  import { mountMeadow } from '../scripts/meadow.js';

  mountMeadow(document.getElementById('meadow') as HTMLCanvasElement);

  const copy = document.getElementById('copy')!;
  copy.addEventListener('click', () => {
    navigator.clipboard?.writeText('cargo add guinea').catch(() => {});
    copy.textContent = 'copied';
    setTimeout(() => (copy.textContent = 'copy'), 1400);
  });
</script>

<style is:global>
  * { box-sizing: border-box }
  html, body { height: 100% }
  body {
    margin: 0;
    background: #8fcbe0;
    color: #1f2a2e;
    font-family: 'Chakra Petch', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: #1f2a2e; text-decoration: none }
  a:hover { color: #b0602a }

  #page {
    position: relative;
    height: 100%;
    min-height: 620px;
    overflow: hidden;
  }

  #meadow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center bottom;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 28px clamp(24px, 5.6vw, 72px);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -.01em;
  }
  .brand img { image-rendering: pixelated }
  .links {
    margin-left: auto;
    display: flex;
    gap: 28px;
    font-size: 16px;
    font-weight: 500;
  }

  .hero {
    position: absolute;
    left: clamp(24px, 5.6vw, 72px);
    top: clamp(96px, 16vh, 150px);
    width: min(620px, calc(100% - 48px));
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .backends {
    align-self: flex-start;
    font: 17px/1.5 'Share Tech Mono', monospace;
    background: rgba(255, 250, 240, .72);
    border: 2px solid #1f2a2e;
    padding: 8px 14px;
  }

  h1 {
    margin: 0;
    font-size: 66px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  .lede {
    margin: 0;
    font-size: 20px;
    line-height: 1.45;
    font-weight: 500;
    max-width: 540px;
    text-wrap: pretty;
  }

  .actions { display: flex; gap: 12px; align-items: stretch; flex-wrap: wrap }
  .install {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fffaf0;
    border: 2px solid #1f2a2e;
    padding: 0 8px 0 16px;
    height: 52px;
    font: 16px 'Share Tech Mono', monospace;
  }
  .prompt { color: #8a8378 }
  #copy {
    font: 13px 'Share Tech Mono', monospace;
    background: #1f2a2e;
    color: #fffaf0;
    border: 0;
    padding: 8px 12px;
    cursor: pointer;
  }
  .start {
    display: flex;
    align-items: center;
    padding: 0 22px;
    height: 52px;
    background: #1f2a2e;
    color: #fffaf0;
    font-weight: 700;
    font-size: 17px;
    box-shadow: 4px 4px 0 #b0602a;
  }
  .start:hover { color: #fffaf0; box-shadow: 2px 2px 0 #b0602a; transform: translate(2px, 2px) }

  .foot {
    position: absolute;
    right: clamp(24px, 5.6vw, 72px);
    bottom: 18px;
    font: 14px 'Share Tech Mono', monospace;
    color: #fffaf0;
    text-shadow: 1px 1px 0 rgba(31, 42, 46, .55);
  }

  @media (max-width: 760px) {
    .links a:not(:last-child) { display: none }
    h1 { font-size: 44px }
    .lede { font-size: 18px }
    .backends { font-size: 15px }
  }

  @media (max-width: 420px) {
    .bar { padding: 22px 18px }
    .hero { left: 18px; width: calc(100% - 36px); gap: 18px }
    h1 { font-size: 36px }
    .lede { font-size: 16px }
    .install { font-size: 14px }
  }
</style>
</body>
</html>
