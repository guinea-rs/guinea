---
import { asset } from '../utils/asset';

const repo = 'https://github.com/guinea-rs/guinea';

const links: [string, string][] = [
  ['Examples', `${repo}/tree/master/examples`],
  ['Plugins', 'https://github.com/guinea-rs/guinea-plugins'],
  ['crates.io', 'https://crates.io/crates/guinea'],
  ['GitHub', repo],
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" href={asset('/favicon.ico')} sizes="any" />
  <link rel="icon" type="image/svg+xml" href={asset('/guinea.svg')} />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="The application layer for Rust GUI." />
  <title>guinea — the application layer for Rust GUI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;700&family=Share+Tech+Mono&display=swap" />
</head>
<body>

<div id="page">
  <canvas id="meadow" aria-hidden="true"></canvas>

  <header class="bar">
    <a class="brand" href={asset('/')}>
      <img src={asset('/guinea.svg')} alt="" width="32" height="32" />
      guinea
    </a>
    <nav class="links">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </header>

  <main class="hero">
    <h1>
      <img src={asset('/guinea.svg')} alt="" width="128" height="128" />
      guinea
    </h1>
    <p class="tagline">The application layer for Rust GUI.</p>
    <div class="actions">
      <div class="install">
        <span class="prompt">$</span>
        <span>cargo add guinea</span>
        <button id="copy" type="button">copy</button>
      </div>
      <a class="start" href={`${repo}#readme`}>Get started</a>
    </div>
  </main>

  <footer class="foot">guinea · MIT OR Apache-2.0</footer>
</div>

<script>
  import { mountMeadow } from '../scripts/meadow.js';

  mountMeadow(document.getElementById('meadow') as HTMLCanvasElement);

  const copy = document.getElementById('copy')!;
  copy.addEventListener('click', () => {
    navigator.clipboard?.writeText('cargo add guinea').catch(() => {});
    copy.textContent = 'copied';
    setTimeout(() => (copy.textContent = 'copy'), 1400);
  });
</script>

<style is:global>
  * { box-sizing: border-box }
  html { font-size: clamp(15px, .8vw, 24px) }
  html, body { height: 100% }
  body {
    margin: 0;
    background: #8fcbe0;
    color: #1f2a2e;
    font-family: 'Chakra Petch', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: #1f2a2e; text-decoration: none }
  a:hover { color: #b0602a }

  #page {
    position: relative;
    height: 100%;
    min-height: 620px;
    overflow: hidden;
  }

  #meadow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center bottom;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.75rem 5.6vw;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: .6rem;
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -.01em;
  }
  .brand img { width: 2.1rem; height: 2.1rem; image-rendering: pixelated }
  .links {
    margin-left: auto;
    display: flex;
    gap: 1.9rem;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .hero {
    position: absolute;
    left: max(5.6vw, 50vw - 36rem);
    top: max(7rem, 22vh);
    width: calc(100% - 2 * 5.6vw);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
  }

  h1 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: .25em;
    font-size: 6rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -.02em;
  }
  h1 img { width: 1.35em; height: 1.35em; image-rendering: pixelated }

  .tagline {
    margin: -.4rem 0 .4rem;
    font-size: 1.6rem;
    line-height: 1.3;
    font-weight: 500;
  }

  .actions { display: flex; gap: .8rem; align-items: stretch; flex-wrap: wrap }
  .install {
    display: flex;
    align-items: center;
    gap: .9rem;
    background: #fffaf0;
    border: 2px solid #1f2a2e;
    padding: 0 .5rem 0 1.1rem;
    height: 3.5rem;
    font: 1.1rem 'Share Tech Mono', monospace;
  }
  .prompt { color: #8a8378 }
  #copy {
    font: .85rem 'Share Tech Mono', monospace;
    background: #1f2a2e;
    color: #fffaf0;
    border: 0;
    padding: .55rem .8rem;
    cursor: pointer;
  }
  .start {
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    height: 3.5rem;
    background: #1f2a2e;
    color: #fffaf0;
    font-weight: 700;
    font-size: 1.15rem;
    box-shadow: .25rem .25rem 0 #b0602a;
  }
  .start:hover { color: #fffaf0; box-shadow: .125rem .125rem 0 #b0602a; transform: translate(.125rem, .125rem) }

  .foot {
    position: absolute;
    right: 5.6vw;
    bottom: 1.1rem;
    font: .9rem 'Share Tech Mono', monospace;
    color: #fffaf0;
    text-shadow: 1px 1px 0 rgba(31, 42, 46, .55);
  }

  @media (max-width: 760px) {
    .links a:not(:last-child) { display: none }
    h1 { font-size: 4rem }
    .tagline { font-size: 1.3rem }
  }

  @media (max-width: 420px) {
    .bar { padding: 1.4rem 18px }
    .hero { left: 18px; width: calc(100% - 36px); gap: 1.2rem }
    h1 { font-size: 3.4rem }
    .tagline { font-size: 1.15rem }
    .install { font-size: .9rem }
  }
</style>
</body>
</html>
