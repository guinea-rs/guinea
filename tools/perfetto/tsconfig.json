{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/model.ts",
    "src/session.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
